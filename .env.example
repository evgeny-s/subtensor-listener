# ---------------------------------------------------------------------------
# subtensor-listener — all configuration is via env (the service is stateless).
# Copy to .env for local dev. NEVER commit a real .env (it's gitignored).
# ---------------------------------------------------------------------------

# HTTP port for the health probes (and the test endpoint). Default 3020.
PORT=3020

# How far back to scan on startup and after a reconnect gap, in minutes.
# Converted to a block count via BLOCK_TIME_SECONDS. Default 10.
BACKFILL_MINUTES=10
BLOCK_TIME_SECONDS=12

# Secret for the test/replay endpoint (POST /test/replay, header x-api-secret).
# Leave UNSET to disable the endpoint entirely (returns 403).
TEST_API_SECRET=

# ---------------------------------------------------------------------------
# LISTENERS — a JSON array. Add as many as you like; each one connects
# independently and notifies its own webhook.
#
# Per-listener fields:
#   network         human-readable label, shown in the alert (e.g. testnet/mainnet)
#   endpoints       RPC websocket URLs; first is primary, rest are failovers
#   events          [{ pallet, event }] to watch (system.CodeUpdated = runtime upgrade)
#   webhookUrl      where to POST the rendered message (Slack workflow webhook, etc.)
#   webhookField    JSON key for the message text (default: "text")
#   messageTemplate optional override; supports {{network}} {{event}} {{pallet}}
#                   {{blockNumber}} {{blockHash}} {{specVersionFrom}}
#                   {{specVersionTo}} {{specVersionChange}} {{timestamp}}
# ---------------------------------------------------------------------------
LISTENERS=[{"network":"Finney Mainnet","endpoints":["wss://subtensor-archive.app.minesight.co.uk"],"events":[{"pallet":"system","event":"CodeUpdated"}],"webhookUrl":"https://hooks.slack.com/triggers/REPLACE/ME/PLEASE"}]
